# Server configuration (read by docker-compose.yml)
# Copy this file to .env and fill in the values.

# Fastify backend port (inside the container — mapped to 3001 on the host)
PORT=3000

# Postgres connection string (used by Prisma inside the backend container).
# The host is "postgres" (the Docker service name), not localhost.
DATABASE_URL=postgresql://fitso:fitso-secret@postgres:5432/fitso?schema=public

# Postgres credentials (used by the postgres container itself)
POSTGRES_USER=fitso
POSTGRES_PASSWORD=fitso-secret
POSTGRES_DB=fitso

# Caddy reverse proxy
# Use ":80" for plain HTTP (good for Tailscale/IP testing).
# Use a real domain like "api.fitso.app" to enable automatic HTTPS.
CADDY_HOST=:80

# Interface Caddy binds host :443 on. Defaults to 0.0.0.0 (all interfaces).
# Set to the LAN IP (e.g. 192.168.1.16) when another service already owns :443
# on a different interface — e.g. `tailscale serve` bound to tailnet IPs.
# CADDY_BIND_IP=192.168.1.16

# Node environment
NODE_ENV=production

# JWT — only used as HS256 fallback if keys/jwt-private.pem is missing.
# With RSA keys in place, this is unused. In production the server refuses
# to start if neither is set. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string

# CORS allowed origin. Defaults to "*" which is fine for the mobile app
# (React Native doesn't send Origin headers). Set to a domain if you ever
# expose the API to browser clients.
# CORS_ORIGIN=https://app.fitso.app

# Backend Docker image (used by docker-compose on the server).
# CI/CD overrides this with the GHCR image. For local dev, leave unset
# and docker-compose will build from the Dockerfile instead.
# BACKEND_IMAGE=ghcr.io/your-username/fitso-backend:latest

# --- Supabase (production Postgres behind the Cloudflare Worker) ---

# Transaction pooler (port 6543) — this is the string that goes into the
# Cloudflare Hyperdrive binding, and is used by server/worker/test-conn.mjs.
SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler (port 5432) — use for `prisma db push` locally AND as the
# value of the SUPABASE_DATABASE_URL GitHub secret (confusingly named; CI
# needs the session pooler because the transaction pooler breaks DDL).
# Percent-encode special chars in the password (e.g. @ -> %40).
SUPABASE_MIGRATION_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
