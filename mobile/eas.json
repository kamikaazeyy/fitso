{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "YOUR_PREVIEW_API_URL"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "YOUR_PRODUCTION_API_URL"
      }
    }
  }
}
