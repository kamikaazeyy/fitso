# Backend REST API base URL used by the mobile app.
# For local development / Android emulator use: http://10.0.2.2:3001
# For a real device on the same LAN use the host's LAN IP, e.g. http://192.168.1.6:3001
# For production use the deployed backend URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# PowerSync sync server URL.
# This is the PowerSync sync server, NOT the Fastify REST API.
# For local development / Android emulator use: http://10.0.2.2:8080
# For production use the deployed PowerSync URL.
EXPO_PUBLIC_POWERSYNC_URL=http://10.0.2.2:8080
