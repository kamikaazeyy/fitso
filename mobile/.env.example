# Backend REST API base URL used by the mobile app — the fitso-api Cloudflare
# Worker. For local development use `wrangler dev` (defaults to port 8787):
# http://10.0.2.2:8787 on the Android emulator, http://localhost:8787 on iOS.
EXPO_PUBLIC_API_URL=https://fitso-api.pranavmehrotra528.workers.dev

# PowerSync Cloud instance URL — found on the instance page in the PowerSync
# dashboard (https://<instance-id>.powersync.journeyapps.com).
# This is the PowerSync sync endpoint, NOT the REST API.
EXPO_PUBLIC_POWERSYNC_URL=https://<instance-id>.powersync.journeyapps.com

# Optional: Mapbox public access token (pk.eyJ...)
# If not provided, Fitso automatically falls back to an open-source tokenless dark vector tile style.
EXPO_PUBLIC_MAPBOX_TOKEN=

