{
  "expo": {
    "name": "Fitso",
    "slug": "fitso",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "fitso",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/482787fa-e962-4caa-af26-286ecaf34de0",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitso.app",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationWhenInUseUsageDescription": "Fitso uses your location to track your running routes, live pace, and distance.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Fitso tracks your route in the background so you can record your workouts with the screen locked.",
        "NSLocationAlwaysUsageDescription": "Fitso tracks your route in the background so you can record your workouts with the screen locked."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C"
      },
      "package": "com.fitso.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fitso uses your location to track your running routes, live pace, and distance.",
          "locationAlwaysAndWhenInUsePermission": "Fitso tracks your route in the background so you can record your workouts with the screen locked.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "infoPlist": {
              "NSAppTransportSecurity": {
                "NSAllowsArbitraryLoads": true
              }
            }
          }
        }
      ],
      "@rnmapbox/maps"
    ],
    "extra": {
      "eas": {
        "projectId": "482787fa-e962-4caa-af26-286ecaf34de0"
      }
    }
  }
}
